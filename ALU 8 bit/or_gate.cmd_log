vhdtdtfi -lib work nand_gate.vhd -lib work or_gate.vhd -prj cpu -o or_gate.spl -module or_gate -template /opt/Xilinx/14.7/ISE_DS/ISE//data/splfile.tft -deleteonerror 
spl2sym -intstyle ise -family spartan6 or_gate.spl /home/ise/cpu/or_gate.sym 
vhdtdtfi -prj cpu -o /home/ise/cpu/or_gate.vhi -module or_gate -template /opt/Xilinx/14.7/ISE_DS/ISE//data/vhdlinst.tft -deleteonerror -lib work nand_gate.vhd -lib work or_gate.vhd 
xst -intstyle ise -ifn "/home/ise/cpu/or_gate.xst" -ofn "/home/ise/cpu/or_gate.syr" 
